rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dashboard data is private: only the gate account may read or write.
    allow read, write: if request.auth != null
                       && (request.auth.token.email == "buildyourhom@gmail.com"
                           || request.auth.uid == "PwZ5Eq83FMSx2Z7Vzn08TkT3nLB2");
  }
}
